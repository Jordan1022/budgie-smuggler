generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @db.Uuid
  displayName String?  @map("display_name")
  timezone    String   @default("America/Chicago")
  currency    String   @default("USD") @map("currency_code")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plaidItems                PlaidItem[]
  bankAccounts              BankAccount[]
  categories                Category[]
  transactions              Transaction[]
  monthlyBudgets            MonthlyBudget[]
  alerts                    Alert[]
  alertEvents               AlertEvent[]
  insightSnapshots          InsightSnapshot[]
  importBatches             ImportBatch[]
  importedTransactions      ImportedTransaction[]
  actionItems               ActionItem[]
  aiRuns                    AiRun[]
  aiFindings                AiFinding[]
  debtAccounts              DebtAccount[]
  recurringItems            RecurringItem[]
  recurringTransactionLinks RecurringTransactionLink[]

  @@map("profiles")
}

model PlaidItem {
  id                   String    @id @default(uuid()) @db.Uuid
  ownerUserId          String    @map("owner_user_id") @db.Uuid
  plaidItemId          String    @unique @map("plaid_item_id")
  accessTokenEncrypted String    @map("access_token_encrypted")
  institutionName      String?   @map("institution_name")
  lastCursor           String?   @map("last_cursor")
  lastSyncAt           DateTime? @map("last_sync_at") @db.Timestamptz(6)
  syncStatus           String    @default("healthy") @map("sync_status")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  owner    Profile       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  accounts BankAccount[]

  @@index([ownerUserId])
  @@map("plaid_items")
}

model BankAccount {
  id               String    @id @default(uuid()) @db.Uuid
  ownerUserId      String    @map("owner_user_id") @db.Uuid
  plaidItemRefId   String?   @map("plaid_item_ref_id") @db.Uuid
  plaidAccountId   String?   @unique @map("plaid_account_id")
  name             String
  mask             String?
  type             String?
  subtype          String?
  sourceType       String    @default("plaid") @map("source_type")
  usageType        String    @default("unknown") @map("usage_type")
  currentBalance   Decimal?  @db.Decimal(14, 2)
  availableBalance Decimal?  @db.Decimal(14, 2)
  lastBalanceAt    DateTime? @map("last_balance_at") @db.Timestamptz(6)
  lastImportedAt   DateTime? @map("last_imported_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  owner                Profile               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  plaidItem            PlaidItem?            @relation(fields: [plaidItemRefId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  importBatches        ImportBatch[]
  importedTransactions ImportedTransaction[]
  debtAccounts         DebtAccount[]

  @@index([ownerUserId])
  @@map("bank_accounts")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  name        String
  color       String?
  icon        String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner          Profile         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  monthlyBudgets MonthlyBudget[]
  recurringItems RecurringItem[]

  @@unique([ownerUserId, name])
  @@index([ownerUserId])
  @@map("categories")
}

model Transaction {
  id                   String   @id @default(uuid()) @db.Uuid
  ownerUserId          String   @map("owner_user_id") @db.Uuid
  bankAccountId        String   @map("bank_account_id") @db.Uuid
  plaidTransactionId   String?  @unique @map("plaid_transaction_id")
  postedDate           DateTime @map("posted_date") @db.Date
  merchantName         String?  @map("merchant_name")
  description          String?
  amount               Decimal  @db.Decimal(14, 2)
  direction            String
  pending              Boolean  @default(false)
  categoryId           String?  @map("category_id") @db.Uuid
  userOverrideCategory Boolean  @default(false) @map("user_override_category")
  rawCategory          String[] @default([]) @map("raw_category")
  sourceType           String   @default("plaid") @map("source_type")
  sourceImportBatchId  String?  @map("source_import_batch_id") @db.Uuid
  usageType            String   @default("unknown") @map("usage_type")
  cashFlowRole         String   @default("spending") @map("cash_flow_role")
  reviewStatus         String   @default("accepted") @map("review_status")
  confidence           Decimal? @db.Decimal(5, 4)
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner          Profile                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  bankAccount    BankAccount                @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  category       Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringLinks RecurringTransactionLink[]

  @@index([ownerUserId, postedDate])
  @@map("transactions")
}

model MonthlyBudget {
  id              String   @id @default(uuid()) @db.Uuid
  ownerUserId     String   @map("owner_user_id") @db.Uuid
  monthStart      DateTime @map("month_start") @db.Date
  categoryId      String   @map("category_id") @db.Uuid
  amountLimit     Decimal  @map("amount_limit") @db.Decimal(14, 2)
  rolloverEnabled Boolean  @default(false) @map("rollover_enabled")

  owner    Profile  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, monthStart, categoryId])
  @@index([ownerUserId])
  @@map("monthly_budgets")
}

model Alert {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  type        String
  channel     String   @default("email")
  enabled     Boolean  @default(true)
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner  Profile      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  events AlertEvent[]

  @@unique([ownerUserId, type])
  @@index([ownerUserId])
  @@map("alerts")
}

model AlertEvent {
  id          String    @id @default(uuid()) @db.Uuid
  ownerUserId String    @map("owner_user_id") @db.Uuid
  alertId     String    @map("alert_id") @db.Uuid
  status      String
  dedupeKey   String    @map("dedupe_key")
  payload     Json
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  owner Profile @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  alert Alert   @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, dedupeKey])
  @@index([ownerUserId])
  @@map("alert_events")
}

model InsightSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  windowStart DateTime @map("window_start") @db.Date
  windowEnd   DateTime @map("window_end") @db.Date
  insightType String   @map("insight_type")
  summary     String
  details     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner Profile @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@map("insight_snapshots")
}

model ImportBatch {
  id                 String    @id @default(uuid()) @db.Uuid
  ownerUserId        String    @map("owner_user_id") @db.Uuid
  bankAccountId      String    @map("bank_account_id") @db.Uuid
  fileName           String    @map("file_name")
  fileType           String    @map("file_type")
  fileHash           String    @map("file_hash")
  parserStatus       String    @default("parsed") @map("parser_status")
  detectedStartDate  DateTime? @map("detected_start_date") @db.Date
  detectedEndDate    DateTime? @map("detected_end_date") @db.Date
  rawFileStoragePath String?   @map("raw_file_storage_path")
  extractedTextPath  String?   @map("extracted_text_path")
  redactionSummary   Json?     @map("redaction_summary")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  owner        Profile               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount           @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions ImportedTransaction[]

  @@index([ownerUserId, createdAt])
  @@map("import_batches")
}

model ImportedTransaction {
  id                     String   @id @default(uuid()) @db.Uuid
  importBatchId          String   @map("import_batch_id") @db.Uuid
  ownerUserId            String   @map("owner_user_id") @db.Uuid
  bankAccountId          String   @map("bank_account_id") @db.Uuid
  rawDate                String?  @map("raw_date")
  parsedDate             DateTime @map("parsed_date") @db.Date
  rawDescription         String   @map("raw_description")
  normalizedDescription  String   @map("normalized_description")
  amount                 Decimal  @db.Decimal(14, 2)
  direction              String
  detectedCategory       String?  @map("detected_category")
  detectedUsageType      String   @default("unknown") @map("detected_usage_type")
  detectedCashFlowRole   String   @default("spending") @map("detected_cash_flow_role")
  duplicateTransactionId String?  @map("duplicate_transaction_id") @db.Uuid
  confidence             Decimal? @db.Decimal(5, 4)
  reviewStatus           String   @default("needs_review") @map("review_status")
  sourceRow              Json     @map("source_row")
  acceptedTransactionId  String?  @map("accepted_transaction_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  owner       Profile     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, reviewStatus])
  @@index([ownerUserId, parsedDate])
  @@map("imported_transactions")
}

model ActionItem {
  id                String    @id @default(uuid()) @db.Uuid
  ownerUserId       String    @map("owner_user_id") @db.Uuid
  type              String
  title             String
  body              String?
  priority          String    @default("normal")
  dueDate           DateTime? @map("due_date") @db.Date
  status            String    @default("open")
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id") @db.Uuid
  source            String    @default("system")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner Profile @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status, priority])
  @@map("action_items")
}

model AiRun {
  id             String   @id @default(uuid()) @db.Uuid
  ownerUserId    String   @map("owner_user_id") @db.Uuid
  provider       String   @default("xai")
  model          String
  purpose        String
  redactionLevel String   @map("redaction_level")
  promptVersion  String   @map("prompt_version")
  inputSummary   Json     @map("input_summary")
  outputStatus   String   @map("output_status")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner    Profile     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  findings AiFinding[]

  @@index([ownerUserId, createdAt])
  @@map("ai_runs")
}

model AiFinding {
  id                String   @id @default(uuid()) @db.Uuid
  aiRunId           String   @map("ai_run_id") @db.Uuid
  ownerUserId       String   @map("owner_user_id") @db.Uuid
  findingType       String   @map("finding_type")
  structuredOutput  Json     @map("structured_output")
  confidence        Decimal? @db.Decimal(5, 4)
  relatedEntityType String?  @map("related_entity_type")
  relatedEntityId   String?  @map("related_entity_id") @db.Uuid
  reviewStatus      String   @default("suggested") @map("review_status")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  aiRun AiRun   @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  owner Profile @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, reviewStatus])
  @@map("ai_findings")
}

model DebtAccount {
  id                   String    @id @default(uuid()) @db.Uuid
  ownerUserId          String    @map("owner_user_id") @db.Uuid
  bankAccountId        String?   @map("bank_account_id") @db.Uuid
  name                 String
  debtType             String    @default("credit_card") @map("debt_type")
  usageType            String    @default("unknown") @map("usage_type")
  balance              Decimal   @db.Decimal(14, 2)
  apr                  Decimal?  @db.Decimal(7, 4)
  minimumPayment       Decimal?  @map("minimum_payment") @db.Decimal(14, 2)
  paymentDueDay        Int?      @map("payment_due_day")
  nextDueDate          DateTime? @map("next_due_date") @db.Date
  statementCloseDay    Int?      @map("statement_close_day")
  creditLimit          Decimal?  @map("credit_limit") @db.Decimal(14, 2)
  promoApr             Decimal?  @map("promo_apr") @db.Decimal(7, 4)
  promoAprExpiresOn    DateTime? @map("promo_apr_expires_on") @db.Date
  spendingStatus       String    @default("active") @map("spending_status")
  lastPaymentAmount    Decimal?  @map("last_payment_amount") @db.Decimal(14, 2)
  lastPaymentDate      DateTime? @map("last_payment_date") @db.Date
  lastStatementBalance Decimal?  @map("last_statement_balance") @db.Decimal(14, 2)
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       Profile      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([ownerUserId, nextDueDate])
  @@map("debt_accounts")
}

model RecurringItem {
  id                    String    @id @default(uuid()) @db.Uuid
  ownerUserId           String    @map("owner_user_id") @db.Uuid
  merchantName          String    @map("merchant_name")
  normalizedMerchantKey String    @map("normalized_merchant_key")
  usageType             String    @default("unknown") @map("usage_type")
  categoryId            String?   @map("category_id") @db.Uuid
  amountMin             Decimal   @map("amount_min") @db.Decimal(14, 2)
  amountMax             Decimal   @map("amount_max") @db.Decimal(14, 2)
  typicalAmount         Decimal   @map("typical_amount") @db.Decimal(14, 2)
  cadence               String    @default("unknown")
  nextExpectedDate      DateTime? @map("next_expected_date") @db.Date
  lastSeenDate          DateTime  @map("last_seen_date") @db.Date
  transactionCount      Int       @default(0) @map("transaction_count")
  status                String    @default("suspected")
  priceIncreaseDetected Boolean   @default(false) @map("price_increase_detected")
  increaseAmount        Decimal?  @map("increase_amount") @db.Decimal(14, 2)
  source                String    @default("rule")
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    Profile                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  category Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  links    RecurringTransactionLink[]

  @@unique([ownerUserId, normalizedMerchantKey, cadence])
  @@index([ownerUserId, status])
  @@index([ownerUserId, nextExpectedDate])
  @@map("recurring_items")
}

model RecurringTransactionLink {
  id              String   @id @default(uuid()) @db.Uuid
  ownerUserId     String   @map("owner_user_id") @db.Uuid
  recurringItemId String   @map("recurring_item_id") @db.Uuid
  transactionId   String   @map("transaction_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner         Profile       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  recurringItem RecurringItem @relation(fields: [recurringItemId], references: [id], onDelete: Cascade)
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, recurringItemId, transactionId])
  @@index([ownerUserId, transactionId])
  @@map("recurring_transaction_links")
}
